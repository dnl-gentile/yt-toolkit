{
  "manifest_version": 3,
  "name": "YouTube Toolkit",
  "short_name": "yt-toolkit",
  "version": "1.6.2",
  "description": "YouTube Toolkit: focused viewing, reading pace, speed controls and dual captions for YouTube and supported course players.",
  "permissions": ["storage", "webNavigation"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://yt-search-bar.web.app/*",
    "https://www.google-analytics.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "lib/ext.js",
        "lib/prefs.js",
        "lib/timedtext.js",
        "lib/wpm.js",
        "lib/clock.js",
        "lib/dual-lang.js",
        "content_script_youtube.js",
        "content/yt-menu-patch.js",
        "content/pace.js",
        "content/captions.js"
      ],
      "css": ["styles.css", "styles-overlay.css", "styles-toggles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://tvweb3.unip.br/*"],
      "js": ["content/videojs-main.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://tvweb3.unip.br/*"],
      "js": [
        "lib/ext.js",
        "lib/prefs.js",
        "lib/clock.js",
        "lib/videojs.js",
        "content/videojs.js"
      ],
      "css": ["styles-videojs.css"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://yt-search-bar.web.app/*"],
      "js": ["lib/ext.js", "content_script_searchapp.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/quiet_mode_on.png",
        "icons/quiet_mode_off.png",
        "icons/quiet_mode_on_black.png",
        "icons/quiet_mode_off_black.png"
      ],
      "matches": ["https://www.youtube.com/*", "https://yt-search-bar.web.app/*"]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "YouTube Toolkit"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
